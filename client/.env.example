# Client Environment Variables Template for Vercel / Production
# Point these to your deployed backend (e.g., Render, Railway, Fly.io, or VPS)

# Backend REST API endpoint (e.g., https://taskboard-api.onrender.com/api)
VITE_API_URL=

# Socket.io server origin (e.g., https://taskboard-api.onrender.com)
VITE_SOCKET_URL=

# Yjs CRDT WebSocket origin (e.g., wss://taskboard-api.onrender.com)
VITE_WS_URL=
