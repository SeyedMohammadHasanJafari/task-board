# Production and Deployment Environment Template
NODE_ENV=production
PORT=5000
# MongoDB Atlas or Local connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/task-board?retryWrites=true&w=majority
JWT_SECRET=generate_a_secure_random_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-domain.vercel.app
VITE_API_URL=/api
